{
  "expo": {
    "name": "FirstPass Vantage",
    "slug": "firstpass-vantage",
    "version": "0.1.0",
    "scheme": "firstpass-vantage",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.pivt.firstpass.vantage",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "requireFullScreen": true
    },
    "android": {
      "package": "au.pivt.firstpass.vantage",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "clubs": [
        {
          "code": "THUNDER",
          "name": "West Coast Thunder",
          "supabaseUrl": "https://gfadnwpxyartrfkrhhlr.supabase.co",
          "anonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdmYWRud3B4eWFydHJma3JoaGxyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIwNTkyNzEsImV4cCI6MjEwNzYzNTI3MX0.dInH_yUCZymzXpW-uFwyM1hrbkZaV1fWufKO6P9ME4E"
        }
      ]
    }
  }
}
