{
  "name": "@firstpass/playhq",
  "version": "0.1.0",
  "description": "PlayHQ's public data for FirstPass: link parsing, the GraphQL queries, the guest session, and parsers for fixtures, line ups, ladders and the live scoring feed.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zapheus-runplaywin/FirstPassVisionVantage.git",
    "directory": "packages/playhq"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "publishConfig": {
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node build.mjs",
    "test:dist": "node --test test-dist/*.test.cjs test-dist/*.test.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
