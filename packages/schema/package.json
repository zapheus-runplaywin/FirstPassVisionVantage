{
  "name": "@firstpass/schema",
  "version": "0.2.0",
  "description": "FirstPass's event model: the append-only game events Vantage records and Vision, HQ and Studio read.",
  "license": "UNLICENSED",
  "author": "PIVT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zapheus-runplaywin/FirstPassVisionVantage.git",
    "directory": "packages/schema"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-package.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
