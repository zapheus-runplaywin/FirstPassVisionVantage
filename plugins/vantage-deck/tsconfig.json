{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"customConditions": ["node"],
		"strict": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"experimentalDecorators": false,
		"skipLibCheck": true,
		"types": ["node"],
		"noEmit": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
